{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-athena.github.io/VEPBench/schemas/question.schema.json",
  "title": "VEPBench generated multiple-choice question",
  "description": "One generated record in a published questions JSONL artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "task_type",
    "prompt",
    "choices",
    "answer_choice_id",
    "provenance",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 200
    },
    "task_type": {
      "const": "multiple_choice"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choice_id", "text"],
        "properties": {
          "choice_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 40
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answer_choice_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 40
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_dataset",
        "source_record_id",
        "template_id",
        "template_version"
      ],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_family"],
      "properties": {
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

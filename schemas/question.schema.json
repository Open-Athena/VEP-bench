{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-athena.github.io/VEPBench/schemas/question.schema.json",
  "title": "VEPBench generated question",
  "description": "One generated record in a published questions JSONL artifact.",
  "oneOf": [
    {"$ref": "#/$defs/multiple_choice_question"},
    {"$ref": "#/$defs/ranking_question"}
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_id", "text"],
      "properties": {
        "choice_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 40
        },
        "text": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "chrom", "pos", "ref", "alt", "reference_score"],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 40
        },
        "chrom": {"const": "element"},
        "pos": {"type": "integer", "minimum": 1},
        "ref": {"type": "string", "pattern": "^[ACGT]+$"},
        "alt": {"type": "string", "pattern": "^[ACGT]+$"},
        "reference_score": {"type": "number"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dataset", "source_record_id", "template_id", "template_version"],
      "properties": {
        "source_dataset": {"type": "string", "minLength": 1},
        "source_record_id": {"type": "string", "minLength": 1},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "template_id": {"type": "string", "minLength": 1},
        "template_version": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_family"],
      "properties": {
        "task_family": {"type": "string", "minLength": 1},
        "tags": {
          "type": "array",
          "default": [],
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "multiple_choice_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_id",
        "task_type",
        "prompt",
        "choices",
        "answer_choice_id",
        "provenance",
        "metadata"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "question_id": {"$ref": "#/$defs/id"},
        "task_type": {"const": "multiple_choice"},
        "prompt": {"type": "string", "minLength": 1},
        "choices": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/choice"}
        },
        "answer_choice_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 40
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    },
    "ranking_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "question_id",
        "task_type",
        "prompt",
        "candidates",
        "provenance",
        "metadata"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "question_id": {"$ref": "#/$defs/id"},
        "task_type": {"const": "ranking"},
        "prompt": {"type": "string", "minLength": 1},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidate"}
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "metadata": {"$ref": "#/$defs/metadata"}
      }
    }
  }
}

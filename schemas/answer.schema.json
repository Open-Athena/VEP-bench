{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-athena.github.io/VEPBench/schemas/answer.schema.json",
  "title": "VEPBench normalized browser answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "question_id", "question_sha256", "completion_index", "evaluated_at", "response", "usage", "scoring", "error", "raw_archive_path"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "question_id": {"$ref": "#/$defs/id"},
    "question_sha256": {"$ref": "#/$defs/sha256"},
    "completion_index": {"type": "integer", "minimum": 0},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "content", "reasoning", "finish_reason", "latency_seconds"],
      "properties": {
        "status": {"enum": ["completed", "api_error"]},
        "content": {"type": ["string", "null"]},
        "reasoning": {"type": ["string", "null"]},
        "finish_reason": {"type": ["string", "null"]},
        "latency_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "usage": {"type": "object"},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "parsed_answer", "value", "correct", "parse_error"],
      "properties": {
        "metric": {"const": "exact_match"},
        "parsed_answer": {"type": ["string", "null"]},
        "value": {"enum": [0, 1, null]},
        "correct": {"type": ["boolean", "null"]},
        "parse_error": {"type": ["string", "null"]},
        "result_type": {"enum": ["correct", "incorrect", "refusal", "token_limit", "format_error", null]}
      }
    },
    "error": {"type": ["object", "null"]},
    "raw_archive_path": {"type": "string", "pattern": "^raw/[A-Za-z0-9][A-Za-z0-9._:-]*\\.jsonl\\.zst$"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 200},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
